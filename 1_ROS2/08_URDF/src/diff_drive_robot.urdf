<?xml version="1.0"?>
<!--
  Differential Drive Robot URDF Model
  Compatible with Webots simulation robot parameters:
    - Wheel Radius: 0.08 m
    - Wheel Separation: 0.24 m
    - Chassis Size: 0.40 m (L) x 0.20 m (W) x 0.10 m (H)
    - Sensors: 360-degree LiDAR, RGB Camera, Caster Wheels
-->
<robot name="diff_drive_robot">

  <!-- ==================== MATERIALS ==================== -->
  <material name="chassis_blue">
    <color rgba="0.1 0.5 0.9 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="caster_gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="lidar_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <material name="camera_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <material name="lens_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <!-- 2D ground projection of the robot center -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Elevation: wheel center is 0.08 m above ground -->
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK (CHASSIS) ==================== -->
  <link name="base_link">
    <!-- Visual Representation -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.10"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>

    <!-- Collision Bounding Box -->
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.20 0.10"/>
      </geometry>
    </collision>

    <!-- Inertial Parameters (Mass: 5.0 kg) -->
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.020833" ixy="0.0" ixz="0.0"
               iyy="0.070833" iyz="0.0"
               izz="0.083333"/>
    </inertial>
  </link>

  <!-- ==================== LEFT WHEEL ==================== -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000867" ixy="0.0" ixz="0.0"
               iyy="0.000867" iyz="0.0"
               izz="0.001600"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <!-- Wheel separation 0.24 m -> y = +0.12 m -->
    <origin xyz="0 0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== RIGHT WHEEL ==================== -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000867" ixy="0.0" ixz="0.0"
               iyy="0.000867" iyz="0.0"
               izz="0.001600"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <!-- Wheel separation 0.24 m -> y = -0.12 m -->
    <origin xyz="0 -0.12 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== FRONT CASTER WHEEL ==================== -->
  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000064" ixy="0.0" ixz="0.0"
               iyy="0.000064" iyz="0.0"
               izz="0.000064"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <!-- Located at front (+0.15 m), bottom touches ground (-0.04 m from base_link) -->
    <origin xyz="0.15 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- ==================== REAR CASTER WHEEL ==================== -->
  <link name="rear_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000064" ixy="0.0" ixz="0.0"
               iyy="0.000064" iyz="0.0"
               izz="0.000064"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <!-- Located at rear (-0.15 m), bottom touches ground (-0.04 m from base_link) -->
    <origin xyz="-0.15 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- ==================== LIDAR SENSOR ==================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="lidar_orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000122" ixy="0.0" ixz="0.0"
               iyy="0.000122" iyz="0.0"
               izz="0.000160"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Mounted on chassis top: z = 0.02 (box center) + 0.05 (half height) + 0.025 = 0.095 m -->
    <origin xyz="0.0 0 0.095" rpy="0 0 0"/>
  </joint>

  <!-- ==================== CAMERA SENSOR ==================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
      <material name="camera_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000061" ixy="0.0" ixz="0.0"
               iyy="0.000015" iyz="0.0"
               izz="0.000061"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Mounted on chassis front: x = 0.20, z = 0.07 -->
    <origin xyz="0.20 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- Standard ROS Optical Frame for Camera Data Processing -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <!-- Standard ROS REP 103 optical rotation: Z forward, X right, Y down -->
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

</robot>
