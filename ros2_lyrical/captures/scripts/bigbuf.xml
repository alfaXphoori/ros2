<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CONFOUNDED profile used for experiment 6 on 2026-11-24 (docs/03 §6), kept unchanged for
  comparison. It changes more than the receive buffer: sendBufferSize is 4 MiB as well, and
  useBuiltinTransports=false removes the builtin SHM transport and replaces the builtin UDPv4
  transport by this user transport (other descriptor fields at their class defaults). It was
  applied to BOTH containers. Superseded by socket_buffer_only.xml.in + run_rcvbuf_sweep.sh
  (docs/03 §9), which changes only listenSocketBufferSize on the receiver.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_bigbuf</transport_id>
        <type>UDPv4</type>
        <receiveBufferSize>4194304</receiveBufferSize>
        <sendBufferSize>4194304</sendBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="bigbuf" is_default_profile="true">
      <rtps>
        <userTransports><transport_id>udp_bigbuf</transport_id></userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
