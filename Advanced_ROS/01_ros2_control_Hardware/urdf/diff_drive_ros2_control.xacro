<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control System Hardware Interface Definition -->
  <ros2_control name="DiffDriveSystem" type="system">
    <hardware>
      <!-- Option A: For Gazebo Sim (Harmonic) Simulation -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>

      <!-- Option B: For Real Robot Hardware (Uncomment on real robot) -->
      <!-- <plugin>my_robot_hardware/DiffDriveHardware</plugin> -->
      <!-- <param name="serial_port">/dev/ttyUSB0</param> -->
      <!-- <param name="baud_rate">115200</param> -->
    </hardware>

    <!-- Left Wheel Actuator Interface -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Right Wheel Actuator Interface -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Sim ros2_control plugin integration -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find my_robot_bringup)/config/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
