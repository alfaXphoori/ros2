<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_adv01</name>
  <version>1.0.0</version>
  <description>Advanced module 01: complete ros2_control robot description (xacro) for the course
    differential-drive AMR, diff_drive_controller + joint_state_broadcaster configuration, a headless
    mock-hardware launch (mock_components/GenericSystem), a Gazebo Sim launch (gz_ros2_control) and a
    TwistStamped -> wheel-speed inverse-kinematics checker.</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>liburdfdom-tools</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
