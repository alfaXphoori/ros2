<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week16</name>
  <version>1.0.0</version>
  <description>Week 16: final demonstration - one-command bringup (Gazebo + robot + bridge +
    Nav2 on the real map) and the autonomous delivery mission executor.</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_week11</exec_depend>
  <exec_depend>amr_week12</exec_depend>
  <exec_depend>amr_week14</exec_depend>
  <exec_depend>amr_week15</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
