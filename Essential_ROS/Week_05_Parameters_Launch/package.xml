<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week05</name>
  <version>1.0.0</version>
  <description>Week 05: node parameters with validation callbacks, a YAML parameter file and the
    core_system launch file that namespaces the Week 02-05 nodes of one robot.</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>amr_week02</exec_depend>
  <exec_depend>amr_week03</exec_depend>
  <exec_depend>amr_week04</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
