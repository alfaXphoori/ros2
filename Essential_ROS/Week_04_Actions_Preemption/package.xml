<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week04</name>
  <version>1.0.0</version>
  <description>Week 04: actions (example_interfaces/Fibonacci as a navigation-distance task) with
