<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week15</name>
  <version>1.0.0</version>
  <description>Week 15: multi-station warehouse patrol with Nav2 NavigateToPose and a custom
    NavigateToPose behavior tree (path smoothing + recovery) loaded by bt_navigator.</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_week11</exec_depend>
  <exec_depend>amr_week14</exec_depend>
  <exec_depend>nav2_behavior_tree</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>amr_week12</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>builtin_interfaces</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
