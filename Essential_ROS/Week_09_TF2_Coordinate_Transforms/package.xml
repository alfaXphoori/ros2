<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week09</name>
  <version>1.0.0</version>
  <description>Week 09: TF2 static broadcaster, TF2 listener (camera_link -> base_link obstacle
    transform) and a launch file that uses exactly one source for the sensor frames.</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_week07</exec_depend>
  <exec_depend>tf2_tools</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>domain_coordinator</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
