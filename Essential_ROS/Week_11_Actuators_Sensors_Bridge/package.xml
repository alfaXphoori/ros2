<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week11</name>
  <version>1.0.0</version>
  <description>Week 11: spawn the course AMR into the warehouse world, bridge /cmd_vel, /odom,
    /scan, /tf, /joint_states and /clock with ros_gz_bridge, and a LiDAR safety gate
    (emergency_stop_node: cmd_vel_in -> cmd_vel).</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_week07</exec_depend>
  <exec_depend>amr_week10</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>gz_tools_vendor</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>tf2_ros_py</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
