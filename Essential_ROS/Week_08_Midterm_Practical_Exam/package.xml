<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_week08</name>
  <version>1.0.0</version>
  <description>Week 08 midterm practical exam: reference solution (hospital_amr.urdf,
    hospital_robot_node, hospital_bringup.launch.py) and an autograder test suite that can be
    pointed at a student submission via EXAM_SUBMISSION_DIR.</description>
  <maintainer email="phoori.ch@ksu.ac.th">Phoori Chantima</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>amr_week07</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>domain_coordinator</test_depend>
  <test_depend>tf2_ros_py</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
