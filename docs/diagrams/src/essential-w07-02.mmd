classDiagram
    class Link {
        +String name
    }
    class Visual {
        +Origin xyz, rpy
        +Geometry (Box, Cylinder, Sphere, Mesh)
        +Material (Color, Texture)
    }
    class Collision {
        +Origin xyz, rpy
        +Geometry (Simplified Primitives)
    }
    class Inertial {
        +Origin xyz, rpy
        +Mass value
        +Inertia (ixx, iyy, izz, ixy, ixz, iyz)
    }

