flowchart TD
    Scan["sensor_msgs/msg/LaserScan"]
    H["Header: stamp (เวลาที่ยิงแสง), frame_id = 'lidar_link'"]
    A["มุมกวาด: angle_min (-180°), angle_max (+180°), angle_increment (0.5°)"]
    R["ระยะทาง: range_min (0.12m), range_max (12.0m)"]
    D["ranges[]: อาเรย์ตัวเลขทศนิยมระบุระยะห่างของแต่ละลำแสง"]

    Scan --> H
    Scan --> A
    Scan --> R
    Scan --> D

    classDef node fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#0f172a
    classDef sim fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#0f172a
    classDef hw fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#0f172a
    classDef sec fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#0f172a
    classDef bt fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#0f172a
    classDef tool fill:#ffedd5,stroke:#ea580c,stroke-width:2px,color:#0f172a
    classDef cfg fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a
    class A,R,D node
    class Scan,H hw
